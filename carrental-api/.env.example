# ─── Database ───────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=carrental
DB_POOL_LIMIT=10

# ─── Server ──────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Allowed origins for CORS (comma-separated, no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# ─── JWT ─────────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_STRING
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Cookie settings
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false   # set true in production (HTTPS only)

# ─── CSRF ────────────────────────────────────────────────────────────────────────
# Shared secret for double-submit cookie signing
CSRF_SECRET=REPLACE_WITH_32_BYTE_HEX_STRING

# ─── Admin ───────────────────────────────────────────────────────────────────────
# Force first-login password change (set to true for fresh deploy)
ADMIN_FORCE_PASSWORD_CHANGE=true

# ─── Email (Nodemailer) ──────────────────────────────────────────────────────────
# Use Mailtrap or SMTP2GO for dev/test
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASS
SMTP_FROM="WanderWheels <noreply@example.com>"

# ─── File uploads ────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads/vehicles
UPLOAD_MAX_MB=5

# ─── Frontend & OAuth Redirects ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Payment Gateway Configuration ──────────────────────────────────────────────
# Set to 'mock' for local simulation (requires NODE_ENV!=production and DB_NAME ending in _test)
# Set to 'razorpay' for official Razorpay integration
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_GATEWAY_SECRET=carrental_mock_gateway_secret_2026

# ─── Google OAuth ────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ─── Seed & Local Development Credentials ─────────────────────────────────────────
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_SUPPORT_EMAIL=support@example.com
SEED_SUPPORT_PHONE="+91 99999 00000"

# ─── Rate-limiting ───────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_GENERAL_MAX=100
